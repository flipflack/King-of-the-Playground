title: Kevin_Bully_End
---
<<if not $kevin_done>>
    <<set $kevin_won to $minigame_won>>
    <<set $kevin_done to true>>
    <<set_phase "end">>
    <<set_phase_for "Daisy" "end">>
<<endif>>
<<if $kevin_won>>
    <<jump Kevin_Bully_End_Won>>
